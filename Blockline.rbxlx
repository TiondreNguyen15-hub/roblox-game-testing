77</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="PointLight" referent="RBX290"><Properties><string name="Name">Warm street light</string><float name="Range">24</float><float name="Brightness">1.4</float></Properties></Item></Item><Item class="Part" referent="RBX293"><Properties><string name="Name">Azure base sign</string><Vector3 name="size"><X>1</X><Y>4</Y><Z>18</Z></Vector3><CoordinateFrame name="CFrame"><X>-115</X><Y>7</Y><Z>14</Z><R00>6.123233995736766e-17</R00><R01>0</R01><R02>1.0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-1.0</R20><R21>0</R21><R22>6.123233995736766e-17</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4280231214</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="Material">272</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="SurfaceGui" referent="RBX294"><Properties><string name="Name">Azure base sign lettering</string><token name="Face">5</token><float name="PixelsPerStud">35</float></Properties><Item class="TextLabel" referent="RBX295"><Properties><string name="Name">Text</string><string name="Text">AZURE / BASE</string><float name="BackgroundTransparency">1</float><bool name="TextScaled">true</bool><token name="Font">19</token><Color3 name="TextColor3"><R>0.1803921568627451</R><G>0.7058823529411765</G><B>0.9372549019607843</B></Color3><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2></Properties></Item></Item></Item><Item class="Part" referent="RBX298"><Properties><string name="Name">Ember base sign</string><Vector3 name="size"><X>1</X><Y>4</Y><Z>18</Z></Vector3><CoordinateFrame name="CFrame"><X>115</X><Y>7</Y><Z>14</Z><R00>6.123233995736766e-17</R00><R01>0</R01><R02>1.0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-1.0</R20><R21>0</R21><R22>6.123233995736766e-17</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4280231214</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="Material">272</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="SurfaceGui" referent="RBX299"><Properties><string name="Name">Ember base sign lettering</string><token name="Face">5</token><float name="PixelsPerStud">35</float></Properties><Item class="TextLabel" referent="RBX300"><Properties><string name="Name">Text</string><string name="Text">EMBER / BASE</string><float name="BackgroundTransparency">1</float><bool name="TextScaled">true</bool><token name="Font">19</token><Color3 name="TextColor3"><R>1.0</R><G>0.5215686274509804</G><B>0.2784313725490196</B></Color3><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2></Properties></Item></Item></Item></Item><Item class="Folder" referent="RBX7"><Properties><string name="Name">05 Team spawns</string></Properties><Item class="SpawnLocation" referent="RBX291"><Properties><string name="Name">Azure spawn</string><Vector3 name="size"><X>14</X><Y>1</Y><Z>18</Z></Vector3><CoordinateFrame name="CFrame"><X>-115</X><Y>0.5</Y><Z>0</Z><R00>1.0</R00><R01>0</R01><R02>0.0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.0</R20><R21>0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4281251055</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Neutral">false</bool><int name="TeamColor">23</int><float name="Duration">3</float><bool name="AllowTeamChangeOnTouch">false</bool></Properties></Item><Item class="SpawnLocation" referent="RBX296"><Properties><string name="Name">Ember spawn</string><Vector3 name="size"><X>14</X><Y>1</Y><Z>18</Z></Vector3><CoordinateFrame name="CFrame"><X>115</X><Y>0.5</Y><Z>0</Z><R00>1.0</R00><R01>0</R01><R02>0.0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.0</R20><R21>0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4294935879</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><bool name="Neutral">false</bool><int name="TeamColor">106</int><float name="Duration">3</float><bool name="AllowTeamChangeOnTouch">false</bool></Properties></Item></Item></Item><Item class="Camera" referent="RBX301"><Properties><string name="Name">Camera</string><CoordinateFrame name="CFrame"><X>170</X><Y>150</Y><Z>175</Z><R00>0.7172793808592268</R00><R01>-0.3649365473292413</R01><R02>0.5935752742640285</R02><R10>0.0</R10><R11>0.8518763913636503</R11><R12>0.5237428890564957</R12><R20>-0.696785684263249</R20><R21>-0.37566997519186596</R21><R22>0.6110333705659116</R22></CoordinateFrame></Properties></Item></Item><Item class="ServerScriptService" referent="RBX302"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX303"><Properties><string name="Name">BlocklineServer</string><ProtectedString name="Source">-- BLOCKLINE: original urban team arena. All combat decisions run on server.
local Players = game:GetService('Players')
local Teams = game:GetService('Teams')
local RS = game:GetService('ReplicatedStorage')
local Debris = game:GetService('Debris')
local Lighting = game:GetService('Lighting')
local remote = Instance.new('RemoteEvent', RS); remote.Name = 'BlocklineAction'
local status = Instance.new('StringValue', RS); status.Name = 'BlocklineStatus'
local arena = workspace:WaitForChild('BlocklineCity', 10)
assert(arena, 'BlocklineCity map missing. Open the updated Blockline.rbxlx place.')
local states = {}
local scores = {Azure = 0, Ember = 0}
local active = false
local gray = Color3.fromRGB(59,65,76)
local orange = Color3.fromRGB(255,122,65)
Lighting.ClockTime = 17; Lighting.Brightness = 2
Lighting.Ambient = Color3.fromRGB(125,132,152)
workspace.FallenPartsDestroyHeight = -60
local function part(name, size, pos, color)
 local p = Instance.new('Part'); p.Name=name; p.Size=size; p.Position=pos
 p.Anchored=true; p.Color=color; p.Parent=arena
 return p
end
for i,name in ipairs({'Azure','Ember'}) do
 local team=Teams:FindFirstChild(name) or Instance.new('Team',Teams)
 team.Name=name; team.TeamColor=BrickColor.new(i==1 and 'Bright blue' or 'Bright orange'); team.AutoAssignable=false
 local spawn=arena:FindFirstChild(name..' spawn',true)
 assert(spawn, name..' spawn missing from city')
 spawn.TeamColor=team.TeamColor; spawn.Neutral=false
end
status.Value='CITY READY'
-- Practice targets respawn and do not award match points.
for _,z in ipairs({-28,28}) do
 local model=Instance.new('Model',arena); model.Name='Practice target'
 local body=part('Torso',Vector3.new(3,4,1.5),Vector3.new(0,3,z),orange); body.Parent=model
 local head=part('Head',Vector3.new(2,2,2),Vector3.new(0,6,z),orange); head.Parent=model
 local function resetTarget()
  local hum=Instance.new('Humanoid',model); hum.RequiresNeck=false; hum.BreakJointsOnDeath=false; hum.MaxHealth=100; hum.Health=100
  hum.Died:Connect(function() task.delay(3,function() if model.Parent then hum:Destroy(); resetTarget() end end) end)
 end
 resetTarget()
end
local function send(p)
 local s=states[p]; if s then remote:FireClient(p,'Ammo',s.ammo,s.reloading) end
end
local function armed(p)
 local char=p.Character; local hum=char and char:FindFirstChildOfClass('Humanoid')
 return char and hum and hum.Health&gt;0 and char:FindFirstChild('AR-24'), hum
end
local function equip(p,char)
 local s={ammo=30,last=0,reloading=false,sprint=false}; states[p]=s
 local hum=char:WaitForChild('Humanoid'); hum.WalkSpeed=16
 local root=char:WaitForChild('HumanoidRootPart')
 local spawn=p.Team and arena:FindFirstChild(p.Team.Name..' spawn',true)
 if spawn then
  p.RespawnLocation=spawn
  local position=spawn.Position+Vector3.new(0,4,0)
  char:PivotTo(CFrame.lookAt(position,Vector3.new(0,position.Y,0)))
 end
 local tool=Instance.new('Tool'); tool.Name='AR-24'; tool.CanBeDropped=false
 local handle=Instance.new('Part',tool); handle.Name='Handle'; handle.Size=Vector3.new(0.45,0.7,2.7)
 handle.Color=Color3.fromRGB(32,38,47); handle.Material=Enum.Material.Metal; handle.CanCollide=false; handle.Massless=true
 local barrel=Instance.new('Part',tool); barrel.Name='Barrel'; barrel.Size=Vector3.new(0.2,0.2,1.5)
 barrel.Color=gray; barrel.Material=Enum.Material.Metal; barrel.CanCollide=false; barrel.Massless=true
 barrel.CFrame=handle.CFrame*CFrame.new(0,0,-1.7)
 local weld=Instance.new('WeldConstraint',handle); weld.Part0=handle; weld.Part1=barrel
 tool.Parent=p:WaitForChild('Backpack'); hum:EquipTool(tool)
 hum.Died:Connect(function() local d=p:FindFirstChild('leaderstats'); if d then d.Deaths.Value=d.Deaths.Value+1 end end)
 send(p)
end
local function setupPlayer(p)
 if p:FindFirstChild('leaderstats') then return end
 local a,b=0,0
 for _,other in ipairs(Players:GetPlayers()) do if other.Team and other.Team.Name=='Azure' then a=a+1 elseif other.Team then b=b+1 end end
 p.Team=Teams:FindFirstChild(a&lt;=b and 'Azure' or 'Ember')
 local stats=Instance.new('Folder',p); stats.Name='leaderstats'
 for _,name in ipairs({'Kills','Deaths'}) do local v=Instance.new('IntValue',stats); v.Name=name end
 p.CharacterAdded:Connect(function(char) equip(p,char) end)
 if p.Character then task.spawn(equip,p,p.Character) end
end
Players.PlayerAdded:Connect(setupPlayer)
for _,p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerRemoving:Connect(function(p) states[p]=nil end)
remote.OnServerEvent:Connect(function(p,action,direction)
 local s=states[p]; if not s then return end
 if action=='Sync' then send(p); return end
 local tool,hum=armed(p); if not tool then return end
 if action=='Sprint' then
  s.sprint=direction==true; hum.WalkSpeed=s.sprint and 23 or 16; return
 end
 if action=='Reload' then
  if s.reloading or s.ammo==30 then return end
  s.reloading=true; send(p)
  task.delay(2,function() if states[p]==s then s.ammo=30; s.reloading=false; send(p) end end)
  return
 end
 if action~='Shoot' or not active or s.reloading or s.sprint or s.ammo&lt;=0 or os.clock()-s.last&lt;0.105 then return end
 if typeof(direction)~='Vector3' then return end
 local magnitude=direction.Magnitude
 if magnitude~=magnitude or magnitude&lt;0.9 or magnitude&gt;1.1 then return end
 local char=p.Character; local head=char and char:FindFirstChild('Head'); if not head then return end
 s.last=os.clock(); s.ammo=s.ammo-1; send(p)
 local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={char}
 local origin=head.Position
 local result=workspace:Raycast(origin,direction.Unit*500,params)
 local finish=result and result.Position or origin+direction.Unit*500
 local tracer=Instance.new('Part'); tracer.Name='Tracer'; tracer.Anchored=true; tracer.CanCollide=false; tracer.CanQuery=false; tracer.CanTouch=false
 tracer.Material=Enum.Material.Neon; tracer.Color=Color3.fromRGB(255,220,135)
 tracer.Size=Vector3.new(0.06,0.06,(finish-origin).Magnitude); tracer.CFrame=CFrame.lookAt((origin+finish)/2,finish); tracer.Parent=workspace; Debris:AddItem(tracer,0.06)
 if not result then return end
 local model=result.Instance:FindFirstAncestorOfClass('Model'); local target=model and model:FindFirstChildOfClass('Humanoid')
 if not target or target.Health&lt;=0 or model:FindFirstChildOfClass('ForceField') then return end
 local victim=Players:GetPlayerFromCharacter(model)
 if victim and victim.Team==p.Team then return end
 local wasAlive=target.Health&gt;0
 target:TakeDamage(result.Instance.Name=='Head' and 48 or 24)
 remote:FireClient(p,'Hit',target.Health&lt;=0)
 if victim and wasAlive and target.Health&lt;=0 then
  p.leaderstats.Kills.Value=p.leaderstats.Kills.Value+1
  scores[p.Team.Name]=scores[p.Team.Name]+1
 end
end)
while true do
 active=false
 for t=10,1,-1 do status.Value='NEXT MATCH  /  '..t; task.wait(1) end
 scores.Azure=0; scores.Ember=0
 for _,p in ipairs(Players:GetPlayers()) do p:LoadCharacter() end
 active=true
 for remaining=300,0,-1 do
  status.Value=string.format('AZURE %02d   /   %d:%02d   /   %02d EMBER',scores.Azure,math.floor(remaining/60),remaining%60,scores.Ember)
  if remaining==0 or scores.Azure&gt;=30 or scores.Ember&gt;=30 then break end
  task.wait(1)
 end
 active=false
 status.Value=scores.Azure==scores.Ember and 'DRAW' or ((scores.Azure&gt;scores.Ember and 'AZURE' or 'EMBER')..' WINS')
 task.wait(6)
end
</ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item><Item class="StarterPlayer" referent="RBX304"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX305"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX306"><Properties><string name="Name">BlocklineClient</string><ProtectedString name="Source">local Players=game:GetService('Players')
local UIS=game:GetService('UserInputService')
local CAS=game:GetService('ContextActionService')
local Run=game:GetService('RunService')
local p=Players.LocalPlayer
local RS=game:GetService('ReplicatedStorage')
local remote=RS:WaitForChild('BlocklineAction')
local status=RS:WaitForChild('BlocklineStatus')
p.CameraMode=Enum.CameraMode.LockFirstPerson
local gui=Instance.new('ScreenGui',p:WaitForChild('PlayerGui')); gui.Name='BlocklineHUD'; gui.ResetOnSpawn=false
local function label(name,text,pos,size,fontSize)
 local l=Instance.new('TextLabel',gui); l.Name=name; l.Text=text; l.Position=pos; l.Size=size
 l.BackgroundColor3=Color3.fromRGB(16,22,32); l.BackgroundTransparency=0.18; l.BorderSizePixel=0
 l.TextColor3=Color3.fromRGB(227,237,246); l.Font=Enum.Font.GothamBold; l.TextSize=fontSize or 18
 local corner=Instance.new('UICorner',l); corner.CornerRadius=UDim.new(0,8)
 return l
end
label('Brand','BLOCKLINE  /  CITY ARENA',UDim2.new(0,16,0,16),UDim2.new(0,280,0,36),16)
local match=label('Match','CONNECTING',UDim2.new(0.5,-190,0,62),UDim2.new(0,380,0,40),18)
local ammo=label('Ammo','AR-24  /  30',UDim2.new(1,-238,1,-95),UDim2.new(0,220,0,52),24)
label('Controls','FIRE: CLICK / RT   •   AIM: RMB / LT   •   RELOAD: R / X   •   SPRINT: SHIFT / L3',UDim2.new(0.5,-300,1,-37),UDim2.new(0,600,0,26),11)
local health=label('Health','100 HP',UDim2.new(0,16,1,-95),UDim2.new(0,150,0,52),24)
local cross=label('Crosshair','+',UDim2.new(0.5,-15,0.5,-15),UDim2.new(0,30,0,30),28); cross.BackgroundTransparency=1
local hit=label('Hit','',UDim2.new(0.5,-65,0.5,32),UDim2.new(0,130,0,28),14); hit.BackgroundTransparency=1
local firing=false; local aiming=false; local ammoCount=30; local reloading=false; local hitVersion=0
local function reset() firing=false; aiming=false; UIS.MouseIconEnabled=false end
p.CharacterAdded:Connect(reset); reset()
status:GetPropertyChangedSignal('Value'):Connect(function() match.Text=status.Value end); match.Text=status.Value
remote.OnClientEvent:Connect(function(action,a,b)
 if action=='Ammo' then ammoCount=a; reloading=b; ammo.Text=b and 'RELOADING…' or ('AR-24  /  '..a..'  ∞') end
 if action=='Hit' then
  hitVersion=hitVersion+1; local version=hitVersion; hit.Text=a and 'ELIMINATED' or 'HIT'; hit.TextColor3=a and Color3.fromRGB(255,140,90) or Color3.fromRGB(90,220,255)
  task.delay(0.4,function() if version==hitVersion then hit.Text='' end end)
 end
end)
local function action(name,state)
 local down=state==Enum.UserInputState.Begin
 if name=='Fire' then firing=down
 elseif name=='Aim' then aiming=down
 elseif name=='Reload' and down then remote:FireServer('Reload')
 elseif name=='Sprint' then remote:FireServer('Sprint',down) end
 return Enum.ContextActionResult.Sink
end
CAS:BindAction('Fire',action,true,Enum.UserInputType.MouseButton1,Enum.KeyCode.ButtonR2)
CAS:BindAction('Aim',action,true,Enum.UserInputType.MouseButton2,Enum.KeyCode.ButtonL2)
CAS:BindAction('Reload',action,true,Enum.KeyCode.R,Enum.KeyCode.ButtonX)
CAS:BindAction('Sprint',action,true,Enum.KeyCode.LeftShift,Enum.KeyCode.ButtonL3)
CAS:SetTitle('Fire','FIRE'); CAS:SetTitle('Aim','AIM'); CAS:SetTitle('Reload','RELOAD'); CAS:SetTitle('Sprint','RUN')
CAS:SetPosition('Fire',UDim2.new(1,-165,1,-155)); CAS:SetPosition('Aim',UDim2.new(1,-245,1,-210))
CAS:SetPosition('Reload',UDim2.new(1,-245,1,-130)); CAS:SetPosition('Sprint',UDim2.new(0,100,1,-165))
UIS.WindowFocusReleased:Connect(function() firing=false; aiming=false; remote:FireServer('Sprint',false) end)
local lastShot=0
Run.RenderStepped:Connect(function(dt)
 local cam=workspace.CurrentCamera
 if not cam then return end
 cam.FieldOfView=cam.FieldOfView+((aiming and 52 or 78)-cam.FieldOfView)*math.min(1,dt*14)
 local char=p.Character; local hum=char and char:FindFirstChildOfClass('Humanoid')
 if hum then health.Text=math.ceil(hum.Health)..' HP' end
 if firing and hum and hum.Health&gt;0 and char:FindFirstChild('AR-24') and ammoCount&gt;0 and not reloading and os.clock()-lastShot&gt;=0.11 then
  lastShot=os.clock()
  local ray=cam:ViewportPointToRay(cam.ViewportSize.X/2,cam.ViewportSize.Y/2)
  remote:FireServer('Shoot',ray.Direction.Unit)
  cam.CFrame=cam.CFrame*CFrame.Angles(math.rad(0.5),0,0)
 end
end)
remote:FireServer('Sync')
