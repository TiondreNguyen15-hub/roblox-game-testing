ollide">true</bool><token name="Material">1088</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX277"><Properties><string name="Name">Lamp fixture</string><Vector3 name="size"><X>3</X><Y>0.5</Y><Z>2</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>17</Y><Z>29</Z><R00>1.0</R00><R01>0</R01><R02>0.0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.0</R20><R21>0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4294957977</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="PointLight" referent="RBX278"><Properties><string name="Name">Warm street light</string><float name="Range">24</float><float name="Brightness">1.4</float></Properties></Item></Item><Item class="Part" referent="RBX279"><Properties><string name="Name">Lamp post</string><Vector3 name="size"><X>0.5</X><Y>17</Y><Z>0.5</Z></Vector3><CoordinateFrame name="CFrame"><X>50</X><Y>8.5</Y><Z>-29</Z><R00>1.0</R00><R01>0</R01><R02>0.0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.0</R20><R21>0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4280231214</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="Material">1088</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX280"><Properties><string name="Name">Lamp fixture</string><Vector3 name="size"><X>3</X><Y>0.5</Y><Z>2</Z></Vector3><CoordinateFrame name="CFrame"><X>50</X><Y>17</Y><Z>-29</Z><R00>1.0</R00><R01>0</R01><R02>0.0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.0</R20><R21>0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4294957977</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="Material">