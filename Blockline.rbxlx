local ammoLabel=text(hud,'',19); ammoLabel.TextXAlignment=Enum.TextXAlignment.Right; ammoLabel.AnchorPoint=Vector2.new(1,1); ammoLabel.Position=UDim2.new(1,-18,1,-24); ammoLabel.Size=UDim2.fromOffset(240,38)
